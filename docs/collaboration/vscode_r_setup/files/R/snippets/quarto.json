{
	// Place your snippets for quarto here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
    "Quarto empty line": {
    "prefix": "br",
    "body": [
      "<br>",
      "$0"
    ],
    "description": "Insert an empy line in Quarto documents"
  },
    "Quarto Div": {
    "prefix": "qdiv",
    "body": [
      ":::",
      "$0",
      ":::"     
    ],
    "description": "Insert an empy div in Quarto documents"
  },
  "Quarto Two Column Layout": {
    "prefix": "qcolumns",
    "body": [
      ":::: {.columns}",
      "",
      "::: {.column width=\"${1:50}%\"}",
      "$0",
			":::",
      "",
      "::: {.column width=\"${2:50}%\"}",
      ":::",
      "",
      "::::"     
    ],
    "description": "Insert a two-column layout for Quarto documents"
  },
  "Quarto Column Layout": {
    "prefix": "qcol",
    "body": [
      "::: {.column width=\"${1:50}%\"}",
      "$0",
			":::"
    ],
    "description": "Insert a single-column for Quarto documents"
  },
  "Quarto Incremental list": {
    "prefix": "qlist",
    "body": [
      "::: {.incremental}",
      "",
      "- $0",
      "",
      ":::"     
    ],
    "description": "Insert an incremental list for Quarto documents"
  },
  "Quarto Fragment": {
    "prefix": "qfrag",
    "body": [
      "::: {.fragment}",
      "$0",
      ":::"     
    ],
    "description": "Insert a div with fragment class for Quarto documents"
  },
  "Quarto Blockquote": {
    "prefix": "qquote",
    "body": [
      "::: {.blockquote}",
      "$0",
      ":::"     
    ],
    "description": "Insert a blockquote in Quarto documents"
  },
  "Quarto footer": {
    "prefix": "qfooter",
    "body": [
      "::: {.footer}",
      "$0",
      ":::"     
    ],
    "description": "Insert a footer in Quarto documents"
  },
  "Quarto comment": {
    "prefix": "qcomment",
    "body": [
      "<!-- $0 -->"
    ],
    "description": "Insert a comment in Quarto documents"
  }
}
